{
    // The CMake project lives in Firmware/, but the workspace root is the repo root.
    "cmake.sourceDirectory": "${workspaceFolder}/Firmware",
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,

    // IntelliSense comes from ST's bundled clangd (see Firmware/.clangd).
    // query-driver lets clangd pick up arm-none-eabi-gcc's builtin include paths.
    "stm32cube-ide-clangd.arguments": [
        "--query-driver=**/arm-none-eabi-*",
        "--header-insertion=never"
    ],

    "files.associations": {
        "*.ioc": "ini",
        "*.ld": "ld"
    },

    // VS Code is the snap build, so its integrated terminal inherits snap's
    // core20 runtime paths. System binaries then load snap's old glibc
    // (undefined symbol: __libc_pthread_init). null removes the variable.
    "terminal.integrated.env.linux": {
        "LD_LIBRARY_PATH": null,
        "GTK_PATH": null,
        "GIO_MODULE_DIR": null,
        "GSETTINGS_SCHEMA_DIR": null,
        "LOCPATH": null
    },

    // Keep generated build output out of search results and the file watcher.
    "search.exclude": {
        "Firmware/build/**": true
    },
    "files.watcherExclude": {
        "**/Firmware/build/**": true
    }
}
